[
 {
  "id": "c0",
  "text": "公元七二六年，深秋。扬州城外的一间旅舍里，二十六岁的李白，独在异乡，夜不能寐。",
  "dur": 7.776
 },
 {
  "id": "p1",
  "text": "床前明月光。",
  "dur": 2.445
 },
 {
  "id": "n1",
  "text": "月光穿过窗棂，悄无声息地，铺满了床前。",
  "dur": 4.704
 },
 {
  "id": "p2",
  "text": "疑是地上霜。",
  "dur": 1.834
 },
 {
  "id": "n2",
  "text": "那一片清辉，白得发冷。恍惚之间，他竟以为，是地上结了一层秋霜。",
  "dur": 6.553
 },
 {
  "id": "p3",
  "text": "举头望明月。",
  "dur": 2.032
 },
 {
  "id": "n3",
  "text": "他抬起头。一轮明月，高悬天际。千里之外的故乡，此刻，也被这同一轮月光照着。",
  "dur": 8.453
 },
 {
  "id": "p4",
  "text": "低头思故乡。",
  "dur": 1.901
 },
 {
  "id": "n4",
  "text": "低下头，思绪便飞回了故乡。那里的炊烟，那里的灯火，还有那些，等他回家的人。",
  "dur": 7.765
 },
 {
  "id": "p5",
  "text": "床前明月光，疑是地上霜。举头望明月，低头思故乡。",
  "dur": 8.653
 },
 {
  "id": "n5",
  "text": "二十个字，一轮明月，照亮了一千三百年的乡愁。",
  "dur": 5.189
 }
]